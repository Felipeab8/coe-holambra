# Exemplo: exporte estas variáveis no serviço; o servidor não lê .env automaticamente.
# Local: python servidor.py. Para acesso online, configure HTTPS no proxy/hospedagem.
HOST=127.0.0.1
PORT=8080
# Dados FORA do código, em volume persistente. Padrão: ../coe-holambra-data
COE_DATA_DIR=../coe-holambra-data
# Local pode ficar vazio. Online: domínio EXATO, sem caminho, com https://.
# O proxy deve preservar o Host; headers X-Forwarded-* não concedem confiança.
COE_PUBLIC_ORIGIN=
